@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Modifier le mot de passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="text-center mb-4">@ViewData["Title"]</h3>

<div class="row justify-content-center">
    <div class="col-md-8">
        <partial name="_StatusMessage" for="StatusMessage" />
        <form id="change-password-form" method="post" class="p-4 rounded utilisateur-container">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.OldPassword" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Veuillez saisir votre ancien mot de passe." />
                <label asp-for="Input.OldPassword">Ancien mot de passe</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Veuillez saisir votre nouveau mot de passe." />
                <label asp-for="Input.NewPassword">Nouveau mot de passe</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Veuillez confirmer votre nouveau mot de passe." />
                <label asp-for="Input.ConfirmPassword">Confirmer le mot de passe</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-outline-primary btn-lg">Mettre à jour le mot de passe</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}