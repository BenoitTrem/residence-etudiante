@page
@model EmailModel
@{
    ViewData["Title"] = "Gérer le courriel";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3 class="text-center mb-4">@ViewData["Title"]</h3>

<div class="row justify-content-center">
    <div class="col-md-8">
        <partial name="_StatusMessage" for="StatusMessage" />
        <form id="email-form" method="post" class="p-4 rounded utilisateur-container">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            @if (Model.IsEmailConfirmed)
            {
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Veuillez saisir votre courriel." disabled />
                    <label asp-for="Email">Courriel actuel</label>
                </div>
            }
            else
            {
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Veuillez saisir votre courriel." disabled />
                    <label asp-for="Email">Courriel actuel</label>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link p-0">Envoyer un courriel de vérification</button>
                </div>
            }

            <div class="form-floating mb-3">
                <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Veuillez saisir votre nouveau courriel." />
                <label asp-for="Input.NewEmail">Nouveau courriel</label>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>

            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-outline-primary btn-lg">
                Modifier le courriel
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}