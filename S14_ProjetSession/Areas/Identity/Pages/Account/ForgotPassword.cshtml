@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <form method="post" class="p-4 rounded utilisateur-container">

            <h2 class="text-center mb-3">Mot de passe oublié</h2>
            <p class="text-center text-muted mb-4">Entrez votre adresse courriel pour réinitialiser votre mot de passe</p>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" placeholder="nom@exemple.com" autocomplete="username" aria-required="true" />
                <label asp-for="Input.Email">Adresse courriel</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-outline-primary btn-lg">Envoyer le lien</button>

            <p class="text-center mt-3">
                <a asp-page="./Login">Retour à la connexion</a>
            </p>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}