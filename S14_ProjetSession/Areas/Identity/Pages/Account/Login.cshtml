@page
@model LoginModel

@{
    ViewData["Title"] = "Se connecter";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <form id="loginForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="p-4 rounded utilisateur-container">

            <h2 class="text-center mb-3">Connexion</h2>
            <p class="text-center text-muted mb-4">Connectez-vous pour continuer</p>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" placeholder="nom@exemple.com" autocomplete="username" />
                <label asp-for="Input.Email">Adresse courriel</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Mot de passe" autocomplete="current-password" />
                <label asp-for="Input.Password">Mot de passe</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">Se souvenir de moi</label>
            </div>

            <button id="loginSubmit" type="submit" class="w-100 btn btn-outline-primary btn-lg">Se connecter</button>

            <p class="text-center mt-3">
                <a asp-page="./ForgotPassword">Mot de passe oublié ?</a>
            </p>
            <p class="text-center">
                Pas encore de compte ? <a asp-page="./Register"> S'inscrire</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}