@model IEnumerable<S14_ProjetSession.Models.Programme>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@*
    Vue : Index PROGRAMME
    Auteur : John Zuleta
*@
@{
    bool isAdmin = (await AuthorizationService.AuthorizeAsync(User, "AdminUniquement")).Succeeded;
    bool isAdminOrGestionnaire = (await AuthorizationService.AuthorizeAsync(User, "AdminOuGestionnaire")).Succeeded;
}

<div class="container">
    <h1 class="mb-5 mt-5">Les programmes</h1>

    @if (isAdminOrGestionnaire)
    {
        <a class="btn btn-primary mb-4 w-100 p-2"
           asp-controller="Programme"
           asp-action="Creer">
            Ajouter un programme
        </a>
    }

    <div class="row mt-5 mb-5">

        @foreach (var p in Model)
        {
            <div class="col-md-4 mb-5">
                <div class="carte h-100 mt-3">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h2 class="card-title mb-0 text-truncate">
                                @p.Nom
                            </h2>
                        </div>

                        <p class="card-text text-muted mb-2">
                            Code : @p.Code
                        </p>

                        <span class="badge bg-primary mb-3">
                            @p.Campus?.Nom
                        </span>

                        @if (isAdminOrGestionnaire)
                        {
                            <div class="d-flex gap-2 mt-4">

                                <a class="btn btn-outline-success flex-fill"
                                   asp-controller="Programme"
                                   asp-action="Modifier"
                                   asp-route-id="@p.Id">
                                    Modifier
                                </a>

                                @if (isAdmin)
                                {
                                    <button class="btn btn-outline-danger flex-fill"
                                            type="button"
                                            data-dialog-open="@($"modalSupprimer_{p.Id}")">
                                        Supprimer
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger flex-fill btn-tooltip"
                                            type="button"
                                            data-dialog-open="modalNonAdmin">
                                        Supprimer
                                        <span class="tooltip-text">
                                            Vous devez être Admin pour effectuer cette action
                                        </span>
                                    </button>
                                }

                            </div>
                        }

                    </div>

                </div>
            

            @if (isAdmin)
            {
                <dialog id="@($"modalSupprimer_{p.Id}")" class="danger">
                    <h2>Suppression d’un programme</h2>

                    <p class="mt-3">
                        Êtes-vous sûr de vouloir supprimer
                        <strong>@p.Nom</strong> ?
                    </p>

                    <form asp-controller="Programme"
                          asp-action="Supprimer"
                          method="post">

                        <input type="hidden" name="id" value="@p.Id" />

                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit"
                                    class="btn btn-outline-danger px-4">
                                Supprimer
                            </button>

                            <button type="button"
                                    class="btn btn-outline-dark px-4"
                                    data-dialog-close>
                                Annuler
                            </button>
                        </div>

                    </form>
                </dialog>
            }
            </div>

        }

    </div>

    <dialog id="modalNonAdmin" class="info-modal">
        <h2>Accès refusé</h2>
        <p>Vous devez être Admin pour effectuer cette action.</p>

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-outline-dark px-4"
                    type="button"
                    data-dialog-close>
                Fermer
            </button>
        </div>
    </dialog>

</div>