@{
    ViewData["Title"] = "Accueil";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">Bienvenue sur Résidences Étudiantes</h1>
        <p class="lead">Trouve facilement un logement étudiant selon ton campus et tes préférences.</p>
    </div>

    <div class="row text-center index-container margin-top-2">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Résidences sécurisées</h5>
                    <p class="card-text">Nos résidences offrent un environnement sûr et confortable pour tous les étudiants.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Proximité des campus</h5>
                    <p class="card-text">Chaque résidence est associée à un campus, pour que tes déplacements soient rapides et pratiques.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Informations complètes</h5>
                    <p class="card-text">Consulte les détails de chaque résidence, y compris la capacité, l’adresse et les options disponibles.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container margin-top">
    <div class="text-center">
        <h2 class="display-6">Prêt à trouver ta résidence étudiante ?</h2>
        <a asp-controller="Residence" asp-action="Index" class="btn btn-outline-primary btn-lg mt-3">Commencer la recherche</a>
    </div>
</div>