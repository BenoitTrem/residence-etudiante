@{
    ViewData["Title"] = "Accueil";
}

<div class="accueil-section d-flex align-items-center justify-content-center text-center text-white">

    <div class="carrousel-fond">
        <div class="diapo diapo-active diapo-1"></div>
        <div class="diapo diapo-2"></div>
        <div class="diapo diapo-3"></div>
        <div class="diapo diapo-4"></div>
        <div class="diapo diapo-5"></div>
    </div>

    <div class="accueil-overlay"></div>

    <div class="accueil-content">
        <p class="accueil-etiquette">Logements étudiants</p>
        <h1 class="display-4 fw-bold accueil-titre">Bienvenue sur Résidences Étudiantes</h1>
        <p class="lead accueil-sous-titre">
            Trouve facilement un logement étudiant selon ton campus et tes préférences.
        </p>
        <div class="accueil-indicateurs">
            <span class="indicateur indicateur-actif" data-index="0"></span>
            <span class="indicateur" data-index="1"></span>
            <span class="indicateur" data-index="2"></span>
            <span class="indicateur" data-index="3"></span>
            <span class="indicateur" data-index="4"></span>
        </div>
    </div>
</div>

    <h2 class="visually-hidden">Avantages des résidences</h2>

    <div class="row text-center index-container margin-top-2">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 card-title">Résidences sécurisées</h3>
                    <p class="card-text">
                        Nos résidences offrent un environnement sûr et confortable pour tous les étudiants.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 card-title">Proximité des campus</h3>
                    <p class="card-text">
                        Chaque résidence est associée à un campus, pour que tes déplacements soient rapides et pratiques.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3 class="h5 card-title">Informations complètes</h3>
                    <p class="card-text">
                        Consulte les détails de chaque résidence, y compris la capacité, l’adresse et les options disponibles.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container margin-top">
    <div class="text-center mb-5">
        <h2 class="display-6">Comment ça marche ?</h2>
        <p class="text-muted">Trouve ton logement en quelques étapes simples.</p>
    </div>

    <div class="mx-auto comment-div">
        <div class="d-flex align-items-start mb-4 p-3 bg-white comment-item">
            <div class="me-3 fs-4 text-primary">
                <i class="bi bi-search"></i>
            </div>
            <div>
                <h3 class="h6 mb-1">Explore les résidences</h3>
                <p class="mb-0 text-muted">
                    Parcours les options disponibles selon tes préférences.
                </p>
            </div>
        </div>

        <div class="d-flex align-items-start mb-4 p-3 bg-white comment-item">
            <div class="me-3 fs-4 text-primary">
                <i class="bi bi-house-door"></i>
            </div>
            <div>
                <h3 class="h6 mb-1">Fais ton choix</h3>
                <p class="mb-0 text-muted">
                    Compare les logements et sélectionne celui qui te correspond.
                </p>
            </div>
        </div>

        <div class="d-flex align-items-start p-3 bg-white comment-item">
            <div class="me-3 fs-4 text-primary">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <h3 class="h6 mb-1">Envoie ta demande</h3>
                <p class="mb-0 text-muted">
                    Complète ta demande rapidement et simplement en ligne.
                </p>
            </div>
        </div>

    </div>
</div>

<div class="container margin-top mb-5 text-center">
    <h2 class="display-6">Prêt à trouver ta résidence étudiante ?</h2>
    <p class="text-muted">Commence dès maintenant et réserve ta place.</p>
    <a asp-controller="Residence" asp-action="Index" class="btn btn-outline-primary btn-lg mt-3 mb-5">
        Commencer la recherche
    </a>
</div>
<div class="margin-top"></div>