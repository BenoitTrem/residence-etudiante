@model List<S14_ProjetSession.Models.Residence>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

<div class="container">
    <h1 class="mb-5 mt-5">@ViewData["Title"]</h1>

     @if ((await AuthorizationService.AuthorizeAsync(User, "AdminOuGestionnaire")).Succeeded)
        {
            <a class="btn btn-primary mb-5 w-100 p-2" asp-controller="Residence" asp-action="AjouterResidence">Ajouter une résidence</a>
        }
    <div class="row">
        @foreach (Residence residence in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="carte card">
                    <div class="card-body">
                        <h5 class="card-title">@residence.Nom</h5>
                        <p class="card-text mb-1">@residence.AdresseString</p>
                        <p class="card-text">@residence.Campus.Nom</p>
                        <p class="mb-1">
                            <strong>Unités totales :</strong>
                            @(residence.Unites != null ? residence.Unites.Count : 0)
                        </p>

                        <p>
                            <strong>
                                @(residence.Unites != null && residence.Unites.Count(u => u.PlacesDisponibles > 0) > 1
                                                            ? "Unités disponibles :"
                                                            : "Unité disponible :")
                            </strong>

                            @if (residence.Unites != null)
                            {
                                int disponibles = residence.Unites.Count(u => u.PlacesDisponibles > 0);

                                if (disponibles == 0)
                                {
                                    <span class="text-danger">Aucune</span>
                                }
                                else
                                {
                                    @disponibles
                                }
                            }
                            else
                            {
                                <span class="text-danger">0</span>
                            }
                        </p>

                        <a class="btn btn-outline-primary w-100 mt-2" asp-controller="Unite" asp-action="Index" asp-route-id="@residence.Id">
                            Voir les unités
                        </a>

                        @if ((await AuthorizationService.AuthorizeAsync(User, "AdminOuGestionnaire")).Succeeded)
                        {
                            <div class="d-flex gap-2 mt-2">
                                <a class="btn btn-outline-success flex-fill" asp-controller="Residence" asp-action="Modifier" asp-route-id="@residence.Id">
                                    Modifier
                                </a>
                          
                                 @if ((await AuthorizationService.AuthorizeAsync(User, "AdminUniquement")).Succeeded)
                                {
                                    <button class="btn btn-outline-danger flex-fill" type="button" data-dialog-open="@($"modalSupprimer_{residence.Id}")">
                                        Supprimer
                                    </button>
                                }
                                 @if ((await AuthorizationService.AuthorizeAsync(User, "GestionnaireUniquement")).Succeeded)
                                {
                                    <button class="btn btn-outline-danger flex-fill btn-tooltip" type="button" data-dialog-open="modalNonAdmin">
                                        Supprimer
                                        <span class="tooltip-text">
                                            Vous devez être Admin pour effectuer cette action
                                        </span>
                                    </button>
                                }
                                </div>
                         }

                        <dialog id="@($"modalSupprimer_{residence.Id}")" class="danger">
                            <h3>Supprimer une résidence</h3>

                            <p class="mt-3">
                                Êtes-vous sûr de vouloir supprimer la résidence <strong>@residence.Nom</strong> ?
                            </p>

                            <form asp-action="Supprimer" asp-controller="Residence" method="post">
                                <input type="hidden" name="id" value="@residence.Id" />

                                <div class="d-flex justify-content-between">
                                    <button type="submit" class="btn btn-outline-danger">Supprimer</button>
                                    <button type="button" class="btn btn-outline-dark" data-dialog-close>Annuler</button>
                                </div>
                            </form>
                        </dialog>

                        <dialog id="modalNonAdmin" class="info-modal">
                            <h3>Accès refusé</h3>
                            <p>Vous devez être Admin pour effectuer cette action.</p>
                            <div class="d-flex justify-content-end mt-3">
                                <button class="btn btn-outline-dark" type="button" data-dialog-close>Fermer</button>
                            </div>
                        </dialog>
                    </div>
                </div>
            </div>
        }
    </div>
</div>