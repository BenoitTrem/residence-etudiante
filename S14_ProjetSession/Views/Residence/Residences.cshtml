@model List<S14_ProjetSession.Models.Residence>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using Microsoft.AspNetCore.Identity
@using S14_ProjetSession.Areas.Identity.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="container">
    <h1 class="mb-5 mt-5">@ViewData["Title"]</h1>

    @if ((await AuthorizationService.AuthorizeAsync(User, "AdminOuGestionnaire")).Succeeded)
    {
        <a class="btn btn-primary mb-4 w-100 p-2" asp-controller="Residence" asp-action="AjouterResidence">
            Ajouter une résidence
        </a>
    }

    <hr />

    <div class="row mt-5">
        @foreach (Residence residence in Model)
        {
            <div class="col-lg-6 col-xl-4 mb-5">
                <div class="carte card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0 text-truncate width" title="@residence.Nom">
                                @residence.Nom
                            </h5>
                            <a class="btn btn-sm btn-outline-primary ms-2 flex-shrink-0" asp-controller="Residence" asp-action="ResidenceDetails" asp-route-id="@residence.Id">
                                Détails
                            </a>
                        </div>

                        <p class="card-text mb-1">@residence.AdresseString</p>
                        <p class="card-text">@residence.Campus.Nom</p>

                        <p class="dispo">
                            @if (residence.UnitesDisponibles == 0)
                            {
                                <span class="dispo-none">Aucune unité disponible</span>
                            }
                            else
                            {
                                <span class="dispo-ok">
                                    @residence.UnitesDisponibles @(residence.UnitesDisponibles > 1 ? "unités disponibles" : "unité disponible")
                                </span>
                            }
                        </p>

                        @if (!User.IsInRole("Admin") && !User.IsInRole("Gestionnaire"))
                        {
                            if (residence.UnitesDisponibles == 0)
                            {
                                <button class="btn btn-outline-secondary" type="button" data-dialog-open="@($"modalIndisponible_{residence.Id}")">
                                    Faire une demande
                                </button>

                                <dialog id="@($"modalIndisponible_{residence.Id}")" class="info-modal">
                                    <div class="text-center py-3 px-3">
                                        <h3 class="mb-3 text-danger fw-bold">
                                            Aucune unité disponible
                                        </h3>
                                        <p class="text-muted fs-5">
                                            Il n’y a actuellement aucune unité disponible dans la résidence
                                            <strong class="text-truncate">@residence.Nom</strong>.
                                        </p>
                                        <p class="text-muted">
                                            Revenez plus tard ou consultez une autre résidence.
                                        </p>
                                        <div class="d-flex justify-content-center mt-4">
                                            <button class="btn btn-outline-dark px-5" type="button" data-dialog-close>
                                                Fermer
                                            </button>
                                        </div>
                                    </div>
                                </dialog>
                            }
                            else
                            {
                                if (!SignInManager.IsSignedIn(User))
                                {
                                    <button class="btn btn-outline-primary" type="button" data-dialog-open="modalConnexion">
                                        Faire une demande
                                    </button>
                                }
                                else if ((await AuthorizationService.AuthorizeAsync(User, "EstEtudiant")).Succeeded)
                                {
                                    <a class="btn btn-outline-primary" asp-controller="Demande" asp-action="Creer">
                                        Faire une demande
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-outline-primary" type="button" data-dialog-open="modalEtudiant">
                                        Faire une demande
                                    </button>
                                }
                            }
                        }

                        @if ((await AuthorizationService.AuthorizeAsync(User, "AdminOuGestionnaire")).Succeeded)
                        {
                            <a class="btn btn-outline-primary w-100 mt-2" asp-controller="Unite" asp-action="Index" asp-route-id="@residence.Id">
                                Voir les unités
                            </a>

                            <div class="d-flex gap-2 mt-2">
                                <a class="btn btn-outline-success flex-fill" asp-controller="Residence" asp-action="ModifierResidence" asp-route-id="@residence.Id">
                                    Modifier
                                </a>

                                @if ((await AuthorizationService.AuthorizeAsync(User, "AdminUniquement")).Succeeded)
                                {
                                    <button class="btn btn-outline-danger flex-fill" type="button" data-dialog-open="@($"modalSupprimer_{residence.Id}")">
                                        Supprimer
                                    </button>
                                }
                                else if ((await AuthorizationService.AuthorizeAsync(User, "GestionnaireUniquement")).Succeeded)
                                {
                                    <button class="btn btn-outline-danger flex-fill btn-tooltip" type="button" data-dialog-open="modalNonAdmin">
                                        Supprimer
                                        <span class="tooltip-text">
                                            Vous devez être Admin pour effectuer cette action
                                        </span>
                                    </button>
                                }
                            </div>
                        }

                        <dialog id="@($"modalSupprimer_{residence.Id}")" class="danger">
                            <h3>Supprimer une résidence</h3>
                            <p class="mt-3">
                                Êtes-vous sûr de vouloir supprimer la résidence
                                <strong class="text-truncate">@residence.Nom</strong> ?
                            </p>

                            <form asp-action="Supprimer" asp-controller="Residence" method="post">
                                <input type="hidden" name="id" value="@residence.Id" />
                                <div class="d-flex justify-content-between">
                                    <button type="submit" class="btn btn-outline-danger px-4">Supprimer</button>
                                    <button type="button" class="btn btn-outline-dark px-4" data-dialog-close>Annuler</button>
                                </div>
                            </form>
                        </dialog>

                        <dialog id="modalNonAdmin" class="info-modal">
                            <h3>Accès refusé</h3>
                            <p>Vous devez être Admin pour effectuer cette action.</p>
                            <div class="d-flex justify-content-end mt-3">
                                <button class="btn btn-outline-dark px-4" type="button" data-dialog-close>
                                    Fermer
                                </button>
                            </div>
                        </dialog>

                        <dialog id="modalConnexion" class="info-modal">
                            <h3>Connexion requise</h3>
                            <p class="mt-3">
                                Vous devez être connecté pour faire une demande.
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-5">
                                <a class="btn btn-outline-primary px-4" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path">
                                    Se connecter
                                </a>
                                <button class="btn btn-outline-dark px-4" type="button" data-dialog-close>
                                    Fermer
                                </button>
                            </div>
                        </dialog>

                        <dialog id="modalEtudiant" class="info-modal">
                            <h3>Profil étudiant requis</h3>
                            <p class="mt-3">
                                Vous devez compléter votre profil étudiant avant de faire une demande.
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-5">
                                <a class="btn btn-outline-primary px-4" asp-controller="Etudiant" asp-action="Creer">
                                    Compléter mon profil
                                </a>
                                <button class="btn btn-outline-dark px-4" type="button" data-dialog-close>
                                    Fermer
                                </button>
                            </div>
                        </dialog>

                    </div>
                </div>
            </div>
        }
    </div>
</div>