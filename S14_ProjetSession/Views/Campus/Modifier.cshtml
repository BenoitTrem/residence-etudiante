@model Campus

@*
    Vue : Edit Campus
    Auteur : John Zuleta
*@

<div class="container mt-5 mb-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <form asp-action="Modifier" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="form-container">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

           
            <div class="mb-4">
                <label asp-for="Nom" class="form-label required"></label>
                <input asp-for="Nom" class="form-control"
                       placeholder="Modifier le nom du campus..." />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>

          
            <div class="mb-4">
                <label asp-for="Abreviation" class="form-label required">
                    Abréviation
                    <span class="info-bulle">
                        ?
                        <span class="info-texte">
                            <div class="info-section mb-2">
                                <strong>Format recommandé :</strong> 2 à 6 lettres
                            </div>
                            <strong>Exemple :</strong> UQO, UQAM, CEGEP
                        </span>
                    </span>
                </label>

                <input asp-for="Abreviation" class="form-control"
                       placeholder="Ex: UQO" maxlength="10" />

                <span asp-validation-for="Abreviation" class="text-danger"></span>
            </div>


            <div class="text-center mt-5 mb-3">
                <button type="submit" class="btn btn-outline-primary w-25">
                    Enregistrer
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-dark ms-2 w-25">
                    Annuler
                </a>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}