@model IEnumerable<Campus>

@*
    Vue : Index Campus
    Auteur : John Zuleta
*@

<partial name="_MessagePartial" />

<h1>Liste des campus</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Abreviation</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nom</td>
                <td>@c.Abreviation</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-primary btn-sm">Modifier</a>

                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button class="btn btn-danger btn-sm">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">Ajouter</a>