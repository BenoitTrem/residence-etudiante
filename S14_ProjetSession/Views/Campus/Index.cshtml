@model PaginatedList<Campus>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@*
    Vue : Index.cshtml
    Description : Affiche la liste des campus
    @Author : John Zuleta
*@

@{
    bool isAdmin = (await AuthorizationService.AuthorizeAsync(User, "AdminUniquement")).Succeeded;
    bool isAdminOrGestionnaire = (await AuthorizationService.AuthorizeAsync(User, "AdminOuGestionnaire")).Succeeded;
}

<div class="container">
    <div class="d-flex align-items-center mb-5 mt-5 gap-3">
        <h1 class="mb-0">Les campus</h1>
        <a class="text-decoration-none text-dark" asp-controller="Campus" asp-action="Index" asp-route-ordre="@ViewData["OrdreTri"]" aria-label="ordre de tri">
            @if ((string)ViewData["OrdreTri"] == "asc")
            {
                <i class="bi bi-sort-alpha-down fs-2"></i>
            }
            else
            {
                <i class="bi bi-sort-alpha-down-alt fs-2"></i>
            }
        </a>
    </div>

    @if (isAdminOrGestionnaire)
    {
        <a class="btn btn-primary mb-4 w-100 p-2"
           asp-controller="Campus"
           asp-action="Creer">
            Ajouter un campus
        </a>
    }

    <div class="row mt-5 mb-5">
        @foreach (var c in Model)
        {
            <div class="col-md-6 mb-5">
                <div class="carte h-100 mt-3">

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h2 class="card-title mb-0 text-truncate">
                                @c.Nom
                            </h2>
                        </div>

                        <p class="card-text text-muted mb-4">
                            Abréviation : @c.Abreviation
                        </p>

                        @if (isAdminOrGestionnaire)
                        {
                            <div class="d-flex gap-2 mt-4">

                                <a class="btn btn-outline-success flex-fill"
                                   asp-controller="Campus"
                                   asp-action="Modifier"
                                   asp-route-id="@c.Id">
                                    Modifier
                                </a>

                                @if (isAdmin)
                                {
                                    <button class="btn btn-outline-danger flex-fill"
                                            type="button"
                                            data-dialog-open="@($"modalSupprimer_{c.Id}")">
                                        Supprimer
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger flex-fill btn-tooltip"
                                            type="button"
                                            data-dialog-open="modalNonAdmin">
                                        Supprimer
                                        <span class="tooltip-text">
                                            Vous devez être Admin pour effectuer cette action
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
           

            @* Modal suppression *@
            @if (isAdmin)
            {
                <dialog id="@($"modalSupprimer_{c.Id}")" class="danger">
                    <h2>Suppression d'un campus</h2>

                    <p class="mt-3">
                        Êtes-vous sûr de vouloir supprimer
                        <strong>@c.Nom</strong> ?
                    </p>

                    <form asp-controller="Campus"
                          asp-action="Supprimer"
                          method="post">

                        <input type="hidden" name="id" value="@c.Id" />

                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit"
                                    class="btn btn-outline-danger px-4">
                                Supprimer
                            </button>

                            <button type="button"
                                    class="btn btn-outline-dark px-4"
                                    data-dialog-close>
                                Annuler
                            </button>
                        </div>
                    </form>
                </dialog>
            }
            </div>
        }
    </div>

    @* Modal accès refusé *@
    <dialog id="modalNonAdmin" class="info-modal">
        <h2>Accès refusé</h2>
        <p>Vous devez être Admin pour effectuer cette action.</p>

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-outline-dark px-4"
                    type="button"
                    data-dialog-close>
                Fermer
            </button>
        </div>
    </dialog>

    <!-- Utilisation du code de pagination fourni par le professeur -->
    <div class="d-flex justify-content-center mt-4 mb-5">
        @if (Model.HasPreviousPage)
        {
            <a asp-action="Index"
               asp-route-noPage="@(Model.PageIndex - 1)"
               asp-route-ordre="@ViewData["OrdreActuel"]"
               class="btn btn-outline-primary me-2">
                <i class="bi bi-chevron-left" aria-label="Précédent"></i> Précédent
            </a>
        }
        @if (Model.HasNextPage)
        {
            <a asp-action="Index"
               asp-route-noPage="@(Model.PageIndex + 1)"
               asp-route-ordre="@ViewData["OrdreActuel"]"
               class="btn btn-outline-primary">
                Suivant <i class="bi bi-chevron-right" aria-label="Suivant"></i>
            </a>
        }
    </div>
</div>