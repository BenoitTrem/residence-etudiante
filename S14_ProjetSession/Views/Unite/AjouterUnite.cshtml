@model S14_ProjetSession.Models.Unite

<div class="container mt-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    @if (TempData["Erreur"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Erreur"]
        </div>
    }

    <form asp-controller="Unite" asp-action="Creer" method="post">

        <input type="hidden" asp-for="ResidenceId" />

        <div class="form-container">

            <div class="mb-4">
                <label asp-for="Numero" class="form-label"></label>
                <input asp-for="Numero" class="form-control" placeholder="Ex: 101" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Capacite" class="form-label"></label>
                <input asp-for="Capacite" class="form-control" placeholder="Nombre de places..." />
                <span asp-validation-for="Capacite" class="text-danger"></span>
            </div>

            <div class="text-center mt-5">
                <button type="submit" class="btn btn-outline-primary w-25">Créer</button>
                <a asp-controller="Unite"asp-action="Index"asp-route-id="@Model.ResidenceId" class="btn btn-outline-dark ms-2 w-25">
                    Annuler
                </a>
            </div>

        </div>
    </form>
</div>
