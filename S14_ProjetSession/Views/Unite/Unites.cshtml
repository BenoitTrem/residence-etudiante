@model List<S14_ProjetSession.Models.Unite>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

<div class="container">
    <div class="d-flex justify-content-between align-items-center mt-5">
        <h1>@ViewData["Title"]</h1>
         <a class="btn btn-outline-dark"" asp-controller="Residence" asp-action="Index">Retour</a>
    </div>
    <p class="mb-2 mt-2">Adresse : @ViewBag.Adresse</p>
    <p>Campus : @ViewBag.Campus</p>
    <p>
        @if (ViewBag.NombreUnites == 0)
        {
            <span class="text-danger">Aucune unité disponible</span>
        }
        else if (ViewBag.NombreUnites == 1)
        {
            <span>1 unité disponible</span>
        }
        else
        {
            <span>@ViewBag.NombreUnites unités disponibles</span>
        }
    </p>

      @if ((await AuthorizationService.AuthorizeAsync(User, "AdminOuGestionnaire")).Succeeded)
         {
            <a class="btn btn-primary mb-5 w-100 p-2 mt-2" asp-controller="Unite" asp-action="AjouterUnite" asp-route-residenceId="@ViewBag.ResidenceId">
                Ajouter une unité
            </a>
         }

    <hr />
  
    <div class="list-group mt-5">

        @foreach (Unite unite in Model)
        {
            <div class="list-group-item unite-row d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="mb-1">Unité #@unite.Numero</h5>

                    <small class="text-muted d-block">
                        <strong>Capacité :</strong> @unite.Capacite étudiants
                    </small>

                    <small class="d-block">
                        @if (unite.PlacesDisponibles == 1)
                        {
                        <span class="text-success"><strong>1 place disponible</strong></span>
                        }
                        else
                        {
                            <span class="text-success">
                                <strong>@unite.PlacesDisponibles places disponibles</strong>
                            </span>
                        }
                    </small>
                </div>
               
                        <div class="d-flex gap-2 mt-2">
                              @if ((await AuthorizationService.AuthorizeAsync(User, "AdminOuGestionnaire")).Succeeded)
                                 {
                                    <a class="btn btn-outline-success flex-fill" asp-controller="Unite" asp-action="Modifier" asp-route-id="@unite.Id">
                                        Modifier
                                    </a>
                                 }
                                @if ((await AuthorizationService.AuthorizeAsync(User, "AdminUniquement")).Succeeded)
                                {
                                   <button class="btn btn-outline-danger flex-fill" type="button" data-dialog-open="@($"modalSupprimer_{unite.Id}")">
                                        Supprimer
                                    </button>
                                }     
                                 @if ((await AuthorizationService.AuthorizeAsync(User, "GestionnaireUniquement")).Succeeded)
                                {
                                      <button class="btn btn-outline-danger flex-fill btn-tooltip" type="button" data-dialog-open="modalNonAdmin">
                                        Supprimer
                                        <span class="tooltip-text">
                                            Vous devez être Admin pour effectuer cette action
                                        </span>
                                    </button>
                                }
                              @if (!User.IsInRole("Admin") && !User.IsInRole("Gestionnaire"))
                              {
                                    <a class="btn btn-outline-primary">
                                        Faire une demande
                                    </a>
                                }
                        </div>

                <dialog id="@($"modalSupprimer_{unite.Id}")" class="danger">
                    <h3>Supprimer une unité</h3>

                    <p class="mt-3">
                        Êtes-vous sûr de vouloir supprimer l'unité #<strong>@unite.Numero</strong> ?
                    </p>

                    <form asp-action="Supprimer" asp-controller="Unite" method="post">
                        <input type="hidden" name="id" value="@unite.Id" />

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-outline-danger">Supprimer</button>
                            <button type="button" class="btn btn-outline-dark" data-dialog-close>Annuler</button>
                        </div>
                    </form>
                </dialog>

                 <dialog id="modalNonAdmin" class="info-modal">
                    <h3>Accès refusé</h3>
                    <p>Vous devez être Admin pour effectuer cette action.</p>
                    <div class="d-flex justify-content-end mt-3">
                        <button class="btn btn-outline-dark" type="button" data-dialog-close>Fermer</button>
                    </div>
                    </dialog>

            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h3 class="mb-3 text-danger fw-bold">
                    Aucune unité disponible
                </h3>

                <p class="text-muted fs-5">
                    Il n’y a actuellement aucune unité disponible dans cette résidence.
                </p>

                <p class="text-muted">
                    Revenez plus tard ou consultez une autre résidence.
                </p>

                <a class="btn btn-outline-primary mt-3"asp-controller="Residence"asp-action="Index">
                    Voir les résidences
                </a>
            </div>
        }

    </div>
</div>