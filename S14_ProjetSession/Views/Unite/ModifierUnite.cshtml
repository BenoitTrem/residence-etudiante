@model S14_ProjetSession.Models.Unite

<div class="container mt-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>
    <p class="text-muted mb-4">
        Résidence actuelle : <strong>@ViewBag.ResidenceActuelle</strong>
    </p>

    <form asp-controller="Unite" asp-action="Modifier" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-container">
            <div class="mb-4">
                <label class="form-label required">Résidence</label>

                <select asp-for="ResidenceId" class="form-select">
                    @foreach (Residence residence in ViewBag.Residences as List<Residence>)
                    {
                        <option value="@residence.Id">
                            @residence.Nom
                        </option>
                    }
                </select>

                <span asp-validation-for="ResidenceId" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Numero" class="form-label required"></label>
                <input asp-for="Numero" class="form-control" placeholder="Ex: 101" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Capacite" class="form-label required"></label>
                <input asp-for="Capacite" class="form-control" placeholder="Nombre de places..." />
                <span asp-validation-for="Capacite" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="AdapteePourMobiliteReduite" class="form-label required"></label>
                <select asp-for="AdapteePourMobiliteReduite" class="form-select">
                    <option value="">-- Sélectionner --</option>
                    <option value="true">Oui</option>
                    <option value="false">Non</option>
                </select>
                <span asp-validation-for="AdapteePourMobiliteReduite" class="text-danger"></span>
            </div>

            <div class="text-center mt-5">
                <button type="submit" class="btn btn-outline-primary w-25">Enregistrer</button>
                <a asp-controller="Unite" asp-action="Index" asp-route-id="@Model.ResidenceId"
                   class="btn btn-outline-dark ms-2 w-25">
                    Annuler
                </a>
            </div>
        </div>
    </form>
</div>