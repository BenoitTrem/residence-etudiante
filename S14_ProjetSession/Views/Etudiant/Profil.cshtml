@model S14_ProjetSession.Models.Etudiant
@inject Microsoft.AspNetCore.Identity.UserManager<S14_ProjetSession.Areas.Identity.Data.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Profil étudiant";
}

<div class="container mb-5">
    <h3 class="text-center mb-5 mt-5">@ViewData["Title"]</h3>

    <div class="row justify-content-center">
        <div class="col-md-10">
            @if (Model != null)
            {
                <form class="p-4 rounded utilisateur-container">
                    <div class="row mb-3">
                        <div class="col-md-6 form-floating">
                            <input asp-for="Nom" class="form-control" disabled />
                            <label asp-for="Nom" class="form-label">Nom</label>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input asp-for="Prenom" class="form-control" disabled />
                            <label asp-for="Prenom" class="form-label">Prénom</label>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 form-floating">
                            <input asp-for="DateNaissance" type="date" class="form-control" disabled />
                            <label asp-for="DateNaissance" class="form-label">Date de naissance</label>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input asp-for="Genre.Nom" class="form-control" disabled />
                            <label class="form-label">Genre</label>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 form-floating">
                            <input asp-for="Programme.Nom" class="form-control" disabled />
                            <label class="form-label">Programme</label>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input asp-for="noEtudiant" class="form-control" disabled />
                            <label class="form-label">No étudiant</label>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 form-floating">
                            <input asp-for="noAdmission" class="form-control" disabled />
                            <label class="form-label">No admission</label>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input asp-for="Telephone" class="form-control" disabled />
                            <label class="form-label">Téléphone</label>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="AdressePermanente" class="form-control" disabled />
                        <label asp-for="AdressePermanente" class="form-label">Adresse permanente</label>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 form-floating">
                            <input asp-for="CourrielInstitutionnel" class="form-control" disabled />
                            <label asp-for="CourrielInstitutionnel" class="form-label">Courriel institutionnel</label>
                        </div>
                        <div class="col-md-6 form-floating">
                            <input asp-for="CourrielPersonnel" class="form-control" disabled />
                            <label asp-for="CourrielPersonnel" class="form-label">Courriel personnel</label>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="MobiliteReduite" class="form-check-input" type="checkbox" disabled />
                        <label asp-for="MobiliteReduite" class="form-check-label">Mobilité réduite</label>
                    </div>

                    <div class="d-flex justify-content-center mt-5">
                        <a class="btn btn-outline-primary w-50" asp-controller="Etudiant" asp-action="Modifier" asp-route-id="@Model.Id">
                            Modifier
                        </a>
                    </div>
                </form>
            }
            else
            {
                <div class="p-4 rounded utilisateur-container text-center">
                    <h4 class="text-center mb-3 text-danger">Profil étudiant requis</h4>
                    <p>Vous n'avez pas encore complété votre profil étudiant.</p>
                    <a class="btn btn-outline-primary mt-3" asp-controller="Etudiant" asp-action="Creer">
                        Compléter mon profil
                    </a>
                </div>
            }
        </div>
    </div>
</div>