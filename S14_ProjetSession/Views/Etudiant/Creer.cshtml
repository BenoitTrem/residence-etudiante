@model S14_ProjetSession.Models.Etudiant

<h1>Ajouter un étudiant</h1>

<form asp-controller="Etudiant" asp-action="Creer" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label asp-for="Nom"></label>
        <input asp-for="Nom" class="form-control" />
        <span asp-validation-for="Nom" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Prenom"></label>
        <input asp-for="Prenom" class="form-control" />
        <span asp-validation-for="Prenom" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="DateNaissance"></label>
        <input asp-for="DateNaissance" type="date" class="form-control" />
        <span asp-validation-for="DateNaissance" class="text-danger"></span>
    </div>

    <div>
        <label>Genre</label>
        <select asp-for="GenreId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Genres, "Id", "Nom"))">
        </select>
        <span asp-validation-for="GenreId" class="text-danger"></span>
    </div>

    <div>
        <label>Programme</label>
        <select asp-for="ProgrammeId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Programmes, "Id", "Nom"))">
        </select>
        <span asp-validation-for="ProgrammeId" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="noEtudiant"></label>
        <input asp-for="noEtudiant" class="form-control" />
        <span asp-validation-for="noEtudiant" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="noAdmission"></label>
        <input asp-for="noAdmission" class="form-control" />
        <span asp-validation-for="noAdmission" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="AdressePermanente"></label>
        <input asp-for="AdressePermanente" class="form-control" />
        <span asp-validation-for="AdressePermanente" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Telephone"></label>
        <input asp-for="Telephone" class="form-control" />
        <span asp-validation-for="Telephone" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="CourrielInstitutionnel"></label>
        <input asp-for="CourrielInstitutionnel" class="form-control" />
        <span asp-validation-for="CourrielInstitutionnel" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="CourrielPersonnel"></label>
        <input asp-for="CourrielPersonnel" class="form-control" />
        <span asp-validation-for="CourrielPersonnel" class="text-danger"></span>
    </div>

    <div>
        <label>
            <input asp-for="MobiliteReduite" />
            Mobilité réduite
        </label>
    </div>

    <button type="submit">Créer</button>
    <a asp-action="Index">Annuler</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
