@model IEnumerable<Etudiant>
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@*
    Vue : Etudiants.cshtml
    Description : Affiche la liste des étudiants sous forme de cartes avec options
                  de modification et suppression selon les rôles.
    @Author : John Zuleta
*@

@{
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, "AdminUniquement")).Succeeded;
}

<div class="container">
    <h1 class="mb-5 mt-5">Les étudiants</h1>

    @if (User.Identity.IsAuthenticated)
    {
        <a class="btn btn-primary mb-4 w-100 p-2"
           asp-controller="Etudiant"
           asp-action="Creer">
            Ajouter un étudiant
        </a>
    }

    <div class="row mt-5 mb-5">
        @foreach (Etudiant etudiant in Model)
        {
            <div class="col-md-6 mb-5">
                <div class="carte h-100 mt-3">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h2 class="card-title mb-0 text-truncate">
                                @etudiant.Prenom @etudiant.Nom
                            </h2>
                        </div>

                        <p class="card-text text-muted mb-4">
                            Programme : @etudiant.Programme.Nom
                        </p>

                        <div class="d-flex gap-2 mt-4">

                            <a class="btn btn-outline-success flex-fill"
                               asp-controller="Etudiant"
                               asp-action="Modifier"
                               asp-route-id="@etudiant.Id">
                                Modifier
                            </a>

                            @if (isAdmin)
                            {
                                <button class="btn btn-outline-danger flex-fill"
                                        type="button"
                                        data-dialog-open="@($"modalSupprimer_{etudiant.Id}")">
                                    Supprimer
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-danger flex-fill btn-tooltip"
                                        type="button"
                                        data-dialog-open="modalNonAdmin">
                                    Supprimer
                                    <span class="tooltip-text">
                                        Vous devez être Admin pour effectuer cette action
                                    </span>
                                </button>
                            }

                        </div>
                    </div>
                </div>
            </div>

            @* Modal suppression *@
            @if (isAdmin)
            {
                <dialog id="@($"modalSupprimer_{etudiant.Id}")" class="danger">
                    <h2>Suppression d'un étudiant</h2>

                    <p class="mt-3">
                        Êtes-vous sûr de vouloir supprimer
                        <strong>@etudiant.Prenom @etudiant.Nom</strong> ?
                    </p>

                    <form asp-controller="Etudiant"
                          asp-action="Supprimer"
                          method="post">

                        <input type="hidden" name="id" value="@etudiant.Id" />

                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit"
                                    class="btn btn-outline-danger px-4">
                                Supprimer
                            </button>

                            <button type="button"
                                    class="btn btn-outline-dark px-4"
                                    data-dialog-close>
                                Annuler
                            </button>
                        </div>
                    </form>
                </dialog>
            }
        }
    </div>

    @* Modal accès refusé *@
    <dialog id="modalNonAdmin" class="info-modal">
        <h2>Accès refusé</h2>
        <p>Vous devez être Admin pour effectuer cette action.</p>

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-outline-dark px-4"
                    type="button"
                    data-dialog-close>
                Fermer
            </button>
        </div>
    </dialog>
</div>