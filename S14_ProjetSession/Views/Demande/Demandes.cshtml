@{
    ViewData["Title"] = "Toutes les demandes";
}

<div class="container">
    <h1>Toutes les demandes</h1>
    <div class="row">
        
            @if (ViewBag.Demandes.Count <= 0)
            {
                <p>Aucune demande trouvée.</p>
            
        }else{
        @foreach (Demande demande in ViewBag.Demandes)
        {
            <partial name="_CarteDemande" model="demande" />
        }
        }
    </div>
</div>