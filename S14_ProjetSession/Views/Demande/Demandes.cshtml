
<div class="container">
    <div class="row">
        
            @if (ViewBag.Demandes.Count <= 0)
            {
                <h1>Y'a pas de demande'</h1>
            
        }else{
        @foreach (Demande demande in ViewBag.Demandes)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    
                    <div class="card-body">
                        
                        <!-- Étudiant -->
                        <h5 class="card-title">
                            @demande.Etudiant.Prenom @demande.Etudiant.Nom
                        </h5>

                        <!-- Infos principales -->
                        <p class="card-text">
                            <strong>Semestre :</strong> @demande.Semestre.NomSemestre <br />
                            <strong>Date :</strong> @demande.DateDemande.ToShortDateString() <br />
                            <strong>Durée bail :</strong> @demande.PrefDureeBail jours
                        </p>

                        <!-- Garant -->
                        <p class="card-text">
                            <strong>Garant :</strong> @demande.NomGarant @demande.PrenomGarant <br />
                            <strong>Téléphone :</strong> @demande.TelephoneGarant
                        </p>

                        <!-- Urgence -->
                        <p class="card-text">
                            <strong>Urgence :</strong> @demande.NomUrgence <br />
                            <strong>Lien :</strong> @demande.LienParenteUrgence
                        </p>

                        <!-- Statut -->
                        <p>
                            @if (demande.ConfirmeSoumission)
                            {
                                <span class="badge bg-success">Confirmée</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">En attente</span>
                            }
                        </p>

                    </div>

                    <div class="card-footer text-end">
                        <a asp-action="Modifier" asp-route-id="@demande.Id" class="btn btn-primary btn-sm">
                            Voir détails
                        </a>
                                               <!-- Bouton pour ouvrir le modal -->
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#exampleModal">
                            Supprimer la demande
                        </button>

                        <!-- Modal -->
                        <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">

                                    <div class="modal-header">
                                        <h5 class="modal-title" id="exampleModalLabel">
                                            Confirmer la suppression
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body">
                                        Êtes-vous certain de vouloir supprimer cette demande ?
                                        <br>
                                        Cette action est irréversible.
                                    </div>

                                    <div class="modal-footer">

                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                            Annuler
                                        </button>

                                        <form asp-action="Supprimer" asp-route-id="@demande.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger">
                                                Supprimer
                                            </button>
                                        </form>

                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
        }
    </div>
</div>