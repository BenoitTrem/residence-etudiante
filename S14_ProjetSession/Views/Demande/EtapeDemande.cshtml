<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Étape 3</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container py-5">
    <div class="card">
        <div class="card-body">

            <h4 class="text-center mb-5 fw-bold">Étape 3 : Créer une Demande</h4>

            <form asp-action="EtapeDemande" method="POST">

                <!-- Session -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Session *</label>
                        <select class="form-select">
                            <option selected disabled>Sélectionner une session</option>
                            @foreach(Semestre semestre in ViewBag.Semestre)
                                    {
                                        <option value="@semestre.Id">@semestre.NomSemestre</option>
                                    }
                        </select>
                    </div>
                </div>

                <!-- Genre -->
                <div class="mb-4">
                    <label class="form-label fw-semibold d-block">Préférences de genre *</label>

                   @foreach (Genre genre in ViewBag.Genres){
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" 
                        name="genre"
                        value="@genre.Id" 
                        type="radio" 
                        id="@genre.Nom">
                        <label class="form-check-label" for="@genre.Nom">@genre.Nom</label>
                    </div>
                   }
                </div>

                <!-- Bouton -->
<div class="mb-4">
    <button type="button" id="addJumelageBtn" class="btn btn-primary">
        + Ajouter un jumelage
    </button>
</div>

<!-- Container -->
<div id="jumelageContainer">

    <!-- Jumelage initial -->
    <div class="row mb-4 jumelage-item">
        <div class="col-md-6">
            <label class="form-label fw-semibold">Nom du jumelage</label>
            <input type="text" name="Nom" class="form-control">
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Courriel du jumelage</label>
            <input type="email" name="Email" class="form-control">
        </div>
    </div>
</div>

<!-- TODO ENLEVER LE INNERHTML -->
<script>
    let maxJumelages = 5;
    let count = 1;

    const container = document.getElementById("jumelageContainer");

    document.getElementById("addJumelageBtn").addEventListener("click", function () {

        if (container.children.length >= maxJumelages) {
            alert("Maximum de 5 jumelages atteint.");
            return;
        }

        let newBlock = document.createElement("div");
        newBlock.classList.add("row", "mb-4", "jumelage-item", "align-items-end");

        newBlock.innerHTML = `
            <div class="col-md-5">
                <label class="form-label fw-semibold">Nom du jumelage</label>
                <input type="text" name="Nom" class="form-control">
            </div>

            <div class="col-md-5">
                <label class="form-label fw-semibold">Courriel du jumelage</label>
                <input type="email" name="Email" class="form-control">
            </div>

            <div class="col-md-2 text-end">
                <button type="button" class="btn btn-danger btn-sm delete-btn">
                    🗑
                </button>
            </div>
        `;

        container.appendChild(newBlock);
        count++;
    });

    // EVENT DELEGATION (important)
    container.addEventListener("click", function (e) {
        if (e.target.classList.contains("delete-btn")) {
            e.target.closest(".jumelage-item").remove();
        }
    });
</script>

                <!-- Préférences -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Préférence durée du bail *</label>
                        <select class="form-select">
