@model Demande
@using S14_ProjetSession.Models


    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Creer" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="SemestreId" class="form-label">Semestre *</label>
        <select id="SemestreId" name="SemestreId" class="form-control" required>
            <option value="">-- Choisir un semestre --</option>
            @foreach (Semestre semestre in ViewBag.Semestres)
            {
                <option value="@semestre.Id">@semestre.NomSemestre</option>
            }
        </select>
        <span asp-validation-for="SemestreId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="PreferencesGenreId" class="form-label">Préférence de genre</label>
        <select id="PreferencesGenreId" name="PreferencesGenreId" class="form-control">
            <option value="">-- Choisir un genre --</option>
            @foreach (Genre genre in ViewBag.Genres)
            {
                <option value="@genre.Id">@genre.Nom</option>
            }
        </select>
        <span asp-validation-for="PreferencesGenreId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="PrefDureeBail" class="form-label">Durée du bail *</label>
        <input asp-for="PrefDureeBail" id="PrefDureeBail" type="number" class="form-control" min="1" required />
        <span asp-validation-for="PrefDureeBail" class="text-danger"></span>
    </div>

    <div class="form-check mb-2">
        <input asp-for="AccepteReglements" class="form-check-input" required />
        <label asp-for="AccepteReglements" class="form-check-label">AccepteReglements *</label>
        <span asp-validation-for="AccepteReglements" class="text-danger"></span>
    </div>

    <div class="form-check mb-2">
        <input asp-for="AccepteTraitementDonnees" class="form-check-input" required />
        <label asp-for="AccepteTraitementDonnees" class="form-check-label">AccepteTraitementDonnees *</label>
        <span asp-validation-for="AccepteTraitementDonnees" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="ConfirmeSoumission" class="form-check-input" required />
        <label asp-for="ConfirmeSoumission" class="form-check-label">ConfirmeSoumission *</label>
        <span asp-validation-for="ConfirmeSoumission" class="text-danger"></span>
    </div>

    <h5>Jumelage</h5>

    <div class="mb-3">
        <id="Jumelage nom0" class="form-label">Jumelage 1 Nom </label>
        <input id="Jumelage nom0" name="Jumelage[0].Nom" class="form-control"  />
        <for="Jumelage email0" class="form-label">Jumelage 1 Email</label>
                <input id="Jumelage email0" name="Jumelage[0].Courriel" class="form-control" />
    </div>
    
    
    <div class="mb-3">
        <id="Jumelage nom1" class="form-label">Jumelage 2 Nom </label>
        <input id="Jumelage nom1" name="Jumelage[1].Nom" class="form-control"  />
        <for="Jumelage email1" class="form-label">Jumelage 2 Email</label>
                <input id="Jumelage email1" name="Jumelage[1].Courriel" class="form-control" />
    </div>

    <div class="mb-3">
        <id="Jumelage nom2" class="form-label">Jumelage 3 Nom </label>
        <input id="Jumelage nom1" name="Jumelage[2].Nom" class="form-control"  />
        <for="Jumelage email2" class="form-label">Jumelage 3 Email</label>
                <input id="Jumelage email2" name="Jumelage[2].Courriel" class="form-control" />
    </div>


    <h5>Garant</h5>

    <div class="mb-3">
        <label asp-for="NomGarant" class="form-label">NomGarant *</label>
        <input asp-for="NomGarant" class="form-control" required />
        <span asp-validation-for="NomGarant" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PrenomGarant" class="form-label">PrenomGarant *</label>
        <input asp-for="PrenomGarant" class="form-control" required />
        <span asp-validation-for="PrenomGarant" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateNaissanceGarant" class="form-label">DateNaissanceGarant *</label>
        <input asp-for="DateNaissanceGarant" type="date" class="form-control" required />
        <span asp-validation-for="DateNaissanceGarant" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CourrielGarant" class="form-label">CourrielGarant *</label>
        <input asp-for="CourrielGarant" type="email" class="form-control" required />
        <span asp-validation-for="CourrielGarant" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TelephoneGarant" class="form-label">TelephoneGarant *</label>
        <input asp-for="TelephoneGarant" type="tel" class="form-control" required />
        <span asp-validation-for="TelephoneGarant" class="text-danger"></span>
    </div>

    <h5>Parent (optionnel)</h5>

    <div class="mb-3">
        <label asp-for="NomParent" class="form-label"></label>
        <input asp-for="NomParent" class="form-control" />
        <span asp-validation-for="NomParent" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CourrielParent" class="form-label"></label>
        <input asp-for="CourrielParent" type="email" class="form-control" />
        <span asp-validation-for="CourrielParent" class="text-danger"></span>
    </div>

    <h5>Contact d'urgence</h5>

    <div class="mb-3">
        <label asp-for="NomUrgence" class="form-label">NomUrgence *</label>
        <input asp-for="NomUrgence" class="form-control" required />
        <span asp-validation-for="NomUrgence" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LienParenteUrgence" class="form-label">LienParenteUrgence *</label>
        <input asp-for="LienParenteUrgence" class="form-control" required />
        <span asp-validation-for="LienParenteUrgence" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TelephoneUrgence" class="form-label">TelephoneUrgence *</label>
        <input asp-for="TelephoneUrgence" type="tel" class="form-control" required />
        <span asp-validation-for="TelephoneUrgence" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}