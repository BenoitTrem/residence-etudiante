@model Demande
@using S14_ProjetSession.Models

<form asp-action="Modifier" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label for="SemestreId" class="form-label">Semestre *</label>
        <select id="SemestreId" name="SemestreId" class="form-control" required>
            <option selected value="@Model.Semestre.Id" >@Model.Semestre.NomSemestre</option>

            @foreach (Semestre semestre in ViewBag.Semestres)
            {
                if (semestre.Id != @Model.Semestre.Id){
                <option value="@semestre.Id">@semestre.NomSemestre</option>
            }
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Préférences de genre</label>

        <div class="border p-2 rounded">
            @foreach (Genre genre in ViewBag.Genres)
            {
                bool estCoche = Model.DemandeGenres != null
                && Model.DemandeGenres.Any(dg => dg.GenreId == genre.Id);

                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="PreferencesGenreIds"
                           value="@genre.Id"
                           @(estCoche ? "checked" : "") />

                    <label class="form-check-label">
                        @genre.Nom
                    </label>
                </div>
            }
        </div>
    </div>
 
    <div class="mb-3">
        <label for="PrefDureeBail" class="form-label">Durée du bail *</label>
        <input asp-for="PrefDureeBail" id="PrefDureeBail" type="number" class="form-control" min="1" required />
    </div>

    <div class="form-check mb-2">
        <input asp-for="AccepteReglements" class="form-check-input" required />
        <label asp-for="AccepteReglements" class="form-check-label">AccepteReglements *</label>
    </div>

    <div class="form-check mb-2">
        <input asp-for="AccepteTraitementDonnees" class="form-check-input" required />
        <label asp-for="AccepteTraitementDonnees" class="form-check-label">AccepteTraitementDonnees *</label>
    </div>

    <div class="form-check mb-3">
        <input asp-for="ConfirmeSoumission" class="form-check-input" required />
        <label asp-for="ConfirmeSoumission" class="form-check-label">ConfirmeSoumission *</label>
    </div>

    <h5>Garant</h5>

    <div class="mb-3">
        <label asp-for="NomGarant" class="form-label">NomGarant *</label>
        <input asp-for="NomGarant" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="PrenomGarant" class="form-label">PrenomGarant *</label>
        <input asp-for="PrenomGarant" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="DateNaissanceGarant" class="form-label">DateNaissanceGarant *</label>
        <input asp-for="DateNaissanceGarant" type="date" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="CourrielGarant" class="form-label">CourrielGarant *</label>
        <input asp-for="CourrielGarant" type="email" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="TelephoneGarant" class="form-label">TelephoneGarant *</label>
        <input asp-for="TelephoneGarant" type="tel" class="form-control" required />
    </div>

    <h5>Parent (optionnel)</h5>

    <div class="mb-3">
        <label asp-for="NomParent" class="form-label"></label>
        <input asp-for="NomParent" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CourrielParent" class="form-label"></label>
        <input asp-for="CourrielParent" type="email" class="form-control" />
    </div>

    <h5>Contact d'urgence</h5>

    <div class="mb-3">
        <label asp-for="NomUrgence" class="form-label">NomUrgence *</label>
        <input asp-for="NomUrgence" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="LienParenteUrgence" class="form-label">LienParenteUrgence *</label>
        <input asp-for="LienParenteUrgence" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="TelephoneUrgence" class="form-label">TelephoneUrgence *</label>
        <input asp-for="TelephoneUrgence" type="tel" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</form>