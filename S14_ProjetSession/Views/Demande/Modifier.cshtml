@* <author>Felix</author> *@

@model S14_ProjetSession.ViewModels.DemandeCreateViewModel

<h1>Modifier la demande</h1>

<form asp-action="Modifier" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Demande.Id" />

    <!-- SEMESTRE -->
    <div class="mb-3">
        <label class="form-label">Semestre *</label>
        <select asp-for="SelectedSemestreId" class="form-control" asp-items="@(new SelectList(Model.Semestres, "Id", "NomSemestre"))" required>
            <option value="">-- Choisir --</option>
        </select>
        <span asp-validation-for="SelectedSemestreId" class="text-danger"></span>
    </div>

    
    <!-- author John  -->
    <!-- prendre les genres cochées -->
    <div class="mb-3">
        <label class="form-label">Préférences de genre</label>
        <div class="border p-2 rounded">
            @foreach (var genre in Model.Genres)
            {
                bool estCoche = Model.SelectedGenreIds != null
                && Model.SelectedGenreIds.Contains(genre.Id);
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedGenreIds"
                           value="@genre.Id"
                           @(estCoche ? "checked" : "") />
                    <label class="form-check-label">
                        @genre.Nom
                    </label>
                </div>
            }
        </div>
    </div>

    <!-- DURÉE DU BAIL -->
    <div class="mb-3">
        <label class="form-label">Durée du bail *</label>
        <input asp-for="Demande.PrefDureeBail" type="number" class="form-control" min="1" required />
    </div>

    <!-- ACCORDS -->
    <div class="form-check mb-2">
        <input asp-for="Demande.AccepteReglements" class="form-check-input" required />
        <label asp-for="Demande.AccepteReglements" class="form-check-label">Accepter les règlements *</label>
    </div>
    <div class="form-check mb-2">
        <input asp-for="Demande.AccepteTraitementDonnees" class="form-check-input" required />
        <label asp-for="Demande.AccepteTraitementDonnees" class="form-check-label">Accepter le traitement des données *</label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Demande.ConfirmeSoumission" class="form-check-input" required />
        <label asp-for="Demande.ConfirmeSoumission" class="form-check-label">Confirmer la soumission *</label>
    </div>

    <!-- JUMELAGES -->
    <h2 class="h5">Jumelage</h2>
    @for (int i = 0; i < Model.Jumelages.Count; i++)
    {
        <div class="mb-3">
            <label class="form-label">Nom du jumelage @(i + 1)</label>
            <input asp-for="Jumelages[i].Nom" class="form-control" />

            <label class="form-label">Courriel du jumelage @(i + 1)</label>
            <input asp-for="Jumelages[i].Courriel" class="form-control" />
        </div>
    }

    <!-- GARANT -->
    <h2 class="h5">Garant</h2>
    <div class="mb-3">
        <label asp-for="Demande.NomGarant" class="form-label">Nom du garant *</label>
        <input asp-for="Demande.NomGarant" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Demande.PrenomGarant" class="form-label">Prénom du garant *</label>
        <input asp-for="Demande.PrenomGarant" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Demande.DateNaissanceGarant" class="form-label">Date de naissance *</label>
        <input asp-for="Demande.DateNaissanceGarant" type="date" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Demande.CourrielGarant" class="form-label">Courriel du garant *</label>
        <input asp-for="Demande.CourrielGarant" type="email" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Demande.TelephoneGarant" class="form-label">Téléphone du garant *</label>
        <input asp-for="Demande.TelephoneGarant" type="tel" class="form-control" required />
    </div>

    <!-- PARENT -->
    <h2 class="h5">Parent (optionnel)</h2>
    <div class="mb-3">
        <label asp-for="Demande.NomParent" class="form-label">Nom du parent</label>
        <input asp-for="Demande.NomParent" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Demande.CourrielParent" class="form-label">Courriel du parent</label>
        <input asp-for="Demande.CourrielParent" type="email" class="form-control" />
    </div>

    <!-- URGENCE -->
    <h2 class="h5">Contact d'urgence</h2>
    <div class="mb-3">
        <label asp-for="Demande.NomUrgence" class="form-label">Nom *</label>
        <input asp-for="Demande.NomUrgence" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Demande.LienParenteUrgence" class="form-label">Lien de parenté *</label>
        <input asp-for="Demande.LienParenteUrgence" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Demande.TelephoneUrgence" class="form-label">Téléphone *</label>
        <input asp-for="Demande.TelephoneUrgence" type="tel" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Mettre à jour</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
