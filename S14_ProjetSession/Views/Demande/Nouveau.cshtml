


<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Étape 3</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>


<script>
    let EtapeActuelle = 3;
    let EtapeMax = 4;

    function Augmenter(){
        if (EtapeActuelle < EtapeMax){
            const EtapeActuel = document.getElementById(EtapeActuelle);
            EtapeActuel.classList.add("d-none");
            EtapeActuelle ++
            const suivant = document.getElementById(EtapeActuelle);
            suivant.classList.remove("d-none");
            
        }
        console.log(EtapeActuelle)
    }

</script>
<body class="bg-light">

    <div id="3"class="">
    @await Html.PartialAsync("_Etape3Preferences")
    </div>
    <div id="4" class="d-none">
    @await Html.PartialAsync("_Etape4InformationComplementaire")
    </div>
    
    <div class="">

    </div>

    <button type="button" onclick="Augmenter()" action="Agument">suivant</button>

</body>
</html>