@if (Model.Count == 0)
{
    <form asp-action="Creer">
        <button type="submit" class="btn btn-primary">
            Créer une demande
        </button>
    </form>
}
else
{
    <ul>
    @foreach (Demande demande in Model)
    {
            <partial name="_CarteDemande" model="demande" />
        }
    
    </ul>
}