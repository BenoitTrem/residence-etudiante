@{
}


    <div class="container py-5">
        <div class="mx-auto bg-white border p-4 p-md-5" style="max-width: 900px;">
            
            <h4 class="text-center fw-bold mb-5">Étape 4 : Informations complémentaires</h4>

            <!-- Cautionnement -->
            <section class="mb-5">
                <h5 class="fw-bold mb-2">Cautionnement</h5>
                <p class="text-muted small mb-4">
                    Veuillez fournir les informations de votre garant (parent/tuteur ou autre) pour le cautionnement.
                </p>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="nomGarant" class="form-label fw-semibold">Nom du garant *</label>
                        <input type="text" class="form-control" id="nomGarant">
                    </div>

                    <div class="col-md-6">
                        <label for="prenomGarant" class="form-label fw-semibold">Prénom du garant *</label>
                        <input type="text" class="form-control" id="prenomGarant">
                    </div>

                    <div class="col-md-6">
                        <label for="dateNaissanceGarant" class="form-label fw-semibold">Date de naissance du garant *</label>
                        <input type="date" class="form-control" id="dateNaissanceGarant">
                    </div>

                    <div class="col-md-6">
                        <label for="courrielGarant" class="form-label fw-semibold">Courriel du garant *</label>
                        <input type="email" class="form-control" id="courrielGarant">
                    </div>

                    <div class="col-md-6">
                        <label for="telephoneGarant" class="form-label fw-semibold">Téléphone du garant *</label>
                        <input type="tel" class="form-control" id="telephoneGarant">
                    </div>
                </div>
            </section>

            <!-- Parent/Tuteur -->
            <section class="mb-5">
                <h5 class="fw-bold mb-4">Parent/Tuteur</h5>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="nomParent" class="form-label fw-semibold">Nom du parent/tuteur</label>
                        <input type="text" class="form-control" id="nomParent">
                    </div>

                    <div class="col-md-6">
                        <label for="courrielParent" class="form-label fw-semibold">Courriel du parent/tuteur</label>
                        <input type="email" class="form-control" id="courrielParent">
                    </div>
                </div>
            </section>

            <!-- Contact d'urgence -->
            <section class="mb-4">
                <h5 class="fw-bold mb-4">Contact d'urgence</h5>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="nomUrgence" class="form-label fw-semibold">Nom *</label>
                        <input type="text" class="form-control" id="nomUrgence">
                    </div>

                    <div class="col-md-6">
                        <label for="lienParente" class="form-label fw-semibold">Lien de parenté *</label>
                        <input type="text" class="form-control" id="lienParente">
                    </div>

                    <div class="col-md-6">
                        <label for="telephoneUrgence" class="form-label fw-semibold">Téléphone *</label>
                        <input type="tel" class="form-control" id="telephoneUrgence">
                    </div>
                </div>
            </section>

            <!-- Bouton -->
            <div class="d-flex justify-content-end mt-5">
                <button type="submit" class="btn btn-primary px-4">
                    Soumettre la Demande
                </button>
            </div>

        </div>
    </div>

