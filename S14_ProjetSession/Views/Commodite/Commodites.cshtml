@model List<S14_ProjetSession.Models.Commodite>

<div class="container mt-5">
    <h1 class="mb-5 mt-5">
        @ViewData["Title"]
        <span class="info-bulle-lg">
            ?
            <span class="info-texte-lg">
                <strong>Qu’est-ce qu’une commodité ?</strong>

                <span class="info-section mb-3 mt-2">
                    Une commodité est un service ou un équipement offert dans une résidence
                    pour améliorer le confort et la qualité de vie des occupants.
                </span>

                <strong>Exemples :</strong>

                <span class="info-section mt-2">
                    Wi-Fi, buanderie, stationnement, salle d’étude, gym, etc.
                </span>
            </span>
        </span>
    </h1>
   
    <button class="btn btn-primary mb-4 w-100 p-2" type="button" onclick="document.getElementById('modalAjouter').showModal()">
        Ajouter une commodité
    </button>

     <div class="hr"></div>

    <div class="d-flex flex-column gap-3 mt-5 mb-5">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <h2 class="mb-3 text-danger fw-bold">
                    Aucune commodité disponible
                </h2>

                <p class="text-muted fs-5">
                    Aucune commodité n’a encore été ajoutée.
                </p>

                <p class="text-muted fs-5">
                    Utilisez le bouton <strong>« Ajouter une commodité »</strong> en haut de la page pour en créer une.
                </p>
            </div>
        }
        else
        {
            @foreach (Commodite commodite in Model)
            {
                <div class="col">
                    <div class="carte-commodite">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <span>@commodite.Nom</span>
                            <div class="d-flex gap-4">
                                <button class="btn btn-outline-success px-3" onclick="ouvreModiferModal(@commodite.Id, '@commodite.Nom')">
                                    Modifier
                                </button>

                                <button class="btn btn-outline-danger px-3" onclick="ouvreSupprimerModal(@commodite.Id, '@commodite.Nom')">
                                    Supprimer
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<dialog id="modalAjouter" class="info">
    <h2>Ajouter une commodité</h2>
    <form asp-action="Creer" asp-controller="Commodite" method="post">
        <div class="mb-3 mt-3">
            <label class="form-label required" for="nomCommodite">Nom</label>
            <input type="text" id="nomCommodite" name="Nom" class="form-control" placeholder="Nom de la commodité" required />
        </div>
        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-outline-primary px-4">Ajouter</button>
            <button type="button" class="btn btn-outline-dark px-4" data-dialog-close>Annuler</button>
        </div>
    </form>
</dialog>

<dialog id="modalModifier" class="info">
    <h2>Modifier une commodité</h2>

    <form asp-action="Modifier" method="post">
        <input type="hidden" id="idCommoditeModifier" name="Id" />

        <div class="mb-3 mt-3">
            <label class="form-label required" for="nomCommoditeModifier">Nom</label>
            <input type="text" id="nomCommoditeModifier" name="Nom" class="form-control" required />
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-outline-primary px-4">Enregistrer</button>
            <button type="button" class="btn btn-outline-dark px-4" data-dialog-close>Annuler</button>
        </div>
    </form>
</dialog>

<dialog id="modalSupprimer" class="danger">
    <h2>Supprimer une commodité</h2>

    <p>
        Êtes-vous sûr de vouloir supprimer <strong id="nomCommoditeSupprimer"></strong> ?
    </p>

    <form asp-action="Supprimer" method="post">
        <input type="hidden" id="idCommoditeSupprimer" name="Id" />

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-outline-danger px-4">Supprimer</button>
            <button type="button" class="btn btn-outline-dark px-4" data-dialog-close>Annuler</button>
        </div>
    </form>
</dialog>