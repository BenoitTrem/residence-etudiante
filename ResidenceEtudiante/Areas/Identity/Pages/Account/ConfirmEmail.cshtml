@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmation du courriel";
}

<div class="d-flex justify-content-center align-items-center">
    <div class="text-center col-12 col-sm-8 col-md-6 col-lg-4 confirmation-container mt-5">

        @if (Model.StatusMessage?.StartsWith("Erreur") == true)
        {
            <div class="mb-3">
                <i class="bi bi-x-circle-fill text-danger fs-1"></i>
            </div>
            <h2 class="fw-bold text-danger">Échec de la confirmation</h2>
            <p class="text-muted">Une erreur est survenue lors de la confirmation de votre courriel. Le lien est peut-être expiré ou invalide.</p>
        }
        else
        {
            <div class="mb-3">
                <i class="bi bi-envelope-check-fill text-success fs-1"></i>
            </div>
            <h2 class="fw-bold text-success">Courriel confirmé !</h2>
            <p class="text-muted">Votre adresse courriel a été confirmée avec succès. Vous pouvez maintenant vous connecter.</p>
        }

        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary mt-3 w-100 btn-lg">
            <i class="bi bi-box-arrow-in-right me-1"></i> Aller à la connexion
        </a>
    </div>
</div>