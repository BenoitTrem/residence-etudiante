@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Réinitialiser le mot de passe";
}

<h3 class="text-center mb-4 mt-5">@ViewData["Title"]</h3>

<div class="row justify-content-center">
    <div class="col-md-8">
        <form method="post" class="p-4 rounded utilisateur-container">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nom@exemple.com" />
                <label asp-for="Input.Email">Adresse courriel</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Veuillez saisir votre nouveau mot de passe." />
                <label asp-for="Input.Password">Nouveau mot de passe</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Veuillez confirmer votre nouveau mot de passe." />
                <label asp-for="Input.ConfirmPassword">Confirmer le mot de passe</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-outline-primary btn-lg">Réinitialiser le mot de passe</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}