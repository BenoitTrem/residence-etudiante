@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirmation du changement de courriel";
}

<div class="d-flex justify-content-center align-items-center">
    <div class="text-center col-12 col-sm-8 col-md-6 col-lg-4 confirmation-container mt-5">

        @if (Model.StatusMessage?.StartsWith("Erreur") == true)
        {
            <div class="mb-3">
                <i class="bi bi-x-circle-fill text-danger fs-1"></i>
            </div>
            <h2 class="fw-bold text-danger">Échec du changement</h2>
            <p class="text-muted">Une erreur est survenue lors de la confirmation de votre nouvelle adresse courriel. Le lien est peut-être expiré ou invalide.</p>
        }
        else
        {
            <div class="mb-3">
                <i class="bi bi-envelope-check-fill text-success fs-1"></i>
            </div>
            <h2 class="fw-bold text-success">Adresse courriel mise à jour !</h2>
            <p class="text-muted">Votre adresse courriel a été modifiée avec succès.</p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-3 w-100 btn-lg">
            <i class="bi bi-house-door me-1"></i> Retour à l'accueil
        </a>
    </div>
</div>