@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmation d'inscription";
}

<div class="d-flex justify-content-center align-items-center">
    <div class="text-center col-12 col-sm-8 col-md-6 col-lg-4 confirmation-container mt-5">

        <div class="mb-3">
            <i class="bi bi-person-check-fill text-success fs-1"></i>
        </div>
        <h2 class="fw-bold text-success">Compte créé avec succès !</h2>
        <p class="text-muted">
            Veuillez consulter votre courriel et cliquer sur le lien de confirmation pour activer votre compte et pouvoir vous connecter.
        </p>

        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary mt-3 w-100 btn-lg">
            <i class="bi bi-box-arrow-in-right me-1"></i> Aller à la connexion
        </a>

    </div>
</div>