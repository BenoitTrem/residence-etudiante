@model ResidenceEtudiante.Models.Etudiant
@inject Microsoft.AspNetCore.Identity.UserManager<ResidenceEtudiante.Areas.Identity.Data.ApplicationUser> UserManager

@{
    ViewData["Title"] = "Profil étudiant";
}

<div class="container mb-5">
    <h1 class="text-center mb-5 mt-5">@ViewData["Title"]</h1>

    <div class="row justify-content-center">
        <div class="col-md-10">

            @if (Model != null)
            {
                <div class="p-4 rounded utilisateur-container">

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Nom</label>
                            <div class="fw-semibold">@Model.Nom</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted">Prénom</label>
                            <div class="fw-semibold">@Model.Prenom</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Date de naissance</label>
                            <div class="fw-semibold">@Model.DateNaissance.ToString("yyyy-MM-dd")</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted">Genre</label>
                            <div class="fw-semibold">@Model.Genre?.Nom</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Programme</label>
                            <div class="fw-semibold">@Model.Programme?.Nom</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted">No étudiant</label>
                            <div class="fw-semibold">@Model.noEtudiant</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">No admission</label>
                            <div class="fw-semibold">@Model.noAdmission</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted">Téléphone</label>
                            <div class="fw-semibold">@Model.Telephone</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Adresse permanente</label>
                        <div class="fw-semibold">@Model.AdressePermanente</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Courriel institutionnel</label>
                            <div class="fw-semibold">@Model.CourrielInstitutionnel</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted">Courriel personnel</label>
                            <div class="fw-semibold">@Model.CourrielPersonnel</div>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" disabled @(Model.MobiliteReduite ? "checked" : "") />
                        <label class="form-check-label">Mobilité réduite</label>
                    </div>

                    <div class="d-flex justify-content-center mt-5 mb-3">
                        <a class="btn btn-outline-primary w-50"
                           asp-controller="Etudiant"
                           asp-action="Modifier"
                           asp-route-id="@Model.Id">
                            Modifier
                        </a>
                    </div>

                </div>
            }
            else
            {
                <div class="p-4 rounded utilisateur-container text-center">
                    <h1 class="text-danger mb-3">Profil étudiant requis</h1>
                    <p>Vous n'avez pas encore complété votre profil étudiant.</p>

                    <a class="btn btn-outline-primary mt-3"
                       asp-controller="Etudiant"
                       asp-action="Creer">
                        Compléter mon profil
                    </a>
                </div>
            }

        </div>
    </div>
</div>