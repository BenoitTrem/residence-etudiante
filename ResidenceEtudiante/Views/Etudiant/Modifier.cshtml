@model ResidenceEtudiante.Models.Etudiant
@*
    Vue : Modifier.cshtml
    Description : Formulaire permettant de modifier les informations d’un étudiant.
    @Author : John Zuleta
*@

<div class="container mt-5 mb-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <form asp-controller="Etudiant" asp-action="Modifier" method="post">
      

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ApplicationUserId" />

        <div class="form-container">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row g-3">

                <!-- NOM -->
                <div class="col-md-6">
                    <label asp-for="Nom" class="form-label required"></label>
                    <input asp-for="Nom" class="form-control"
                           placeholder="Modifier le nom..." />
                    <span asp-validation-for="Nom" class="text-danger"></span>
                </div>

                <!-- PRÉNOM -->
                <div class="col-md-6">
                    <label asp-for="Prenom" class="form-label required"></label>
                    <input asp-for="Prenom" class="form-control"
                           placeholder="Modifier le prénom..." />
                    <span asp-validation-for="Prenom" class="text-danger"></span>
                </div>

                <!-- DATE NAISSANCE -->
                <div class="col-md-6">
                    <label asp-for="DateNaissance" class="form-label required"></label>
                    <input asp-for="DateNaissance" type="date" class="form-control" />
                    <span asp-validation-for="DateNaissance" class="text-danger"></span>
                </div>

                <!-- GENRE -->
                <div class="col-md-6">
                    <label class="form-label">Genre</label>
                    <select asp-for="GenreId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Genres, "Id", "Nom"))">
                    </select>
                    <span asp-validation-for="GenreId" class="text-danger"></span>
                </div>

                <!-- PROGRAMME -->
                <div class="col-md-6">
                    <label class="form-label">Programme</label>
                    <select asp-for="ProgrammeId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Programmes, "Id", "Nom"))">
                    </select>
                    <span asp-validation-for="ProgrammeId" class="text-danger"></span>
                </div>

                <!-- CAMPUS -->
                <div class="col-md-6">
                    <label class="form-label">Campus</label>
                    <select asp-for="CampusId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Campus, "Id", "Nom"))">
                    </select>
                    <span asp-validation-for="CampusId" class="text-danger"></span>
                </div>

                <!-- NO ÉTUDIANT -->
                <div class="col-md-6">
                    <label asp-for="noEtudiant" class="form-label required"></label>
                    <input asp-for="noEtudiant" class="form-control" />
                    <span asp-validation-for="noEtudiant" class="text-danger"></span>
                </div>

                <!-- NO ADMISSION -->
                <div class="col-md-6">
                    <label asp-for="noAdmission" class="form-label"></label>
                    <input asp-for="noAdmission" class="form-control" />
                    <span asp-validation-for="noAdmission" class="text-danger"></span>
                </div>

                <!-- TÉLÉPHONE -->
                <div class="col-md-6">
                    <label asp-for="Telephone" class="form-label required"></label>
                    <input asp-for="Telephone" class="form-control" />
                    <span asp-validation-for="Telephone" class="text-danger"></span>
                </div>

                <!-- ADRESSE -->
                <div class="col-12">
                    <label asp-for="AdressePermanente" class="form-label required"></label>
                    <input asp-for="AdressePermanente" class="form-control"
                           placeholder="Adresse complète..." />
                    <span asp-validation-for="AdressePermanente" class="text-danger"></span>
                </div>

                <!-- COURRIEL INSTITUTIONNEL -->
                <div class="col-md-6">
                    <label asp-for="CourrielInstitutionnel" class="form-label"></label>
                    <input asp-for="CourrielInstitutionnel" class="form-control" />
                </div>

                <!-- COURRIEL PERSONNEL -->
                <div class="col-md-6">
                    <label asp-for="CourrielPersonnel" class="form-label"></label>
                    <input asp-for="CourrielPersonnel" class="form-control" />
                </div>

                <!-- MOBILITÉ -->
                <div class="col-12">
                    <div class="form-check mt-2">
                        <input asp-for="MobiliteReduite" class="form-check-input" />
                        <label class="form-check-label">
                            Mobilité réduite
                        </label>
                    </div>
                </div>

            </div>

            <!-- BUTTONS -->
            <div class="text-center mt-5 mb-3">
                <button type="submit" class="btn btn-outline-primary w-25">
                    Enregistrer
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-dark ms-2 w-25">
                    Annuler
                </a>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}